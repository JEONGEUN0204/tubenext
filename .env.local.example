# ─────────────────────────────────────────────
# YouTube Data API v3
# 발급: https://console.cloud.google.com/apis/credentials
#   1) 프로젝트 생성 → 2) "YouTube Data API v3" 사용 설정
#   3) 사용자 인증 정보 → API 키 만들기
# 무료 할당량: 10,000 units/day
# ─────────────────────────────────────────────
YOUTUBE_API_KEY=

# ─────────────────────────────────────────────
# Anthropic API (콘텐츠 추천 생성용)
# 발급: https://console.anthropic.com/settings/keys
# ─────────────────────────────────────────────
ANTHROPIC_API_KEY=

# ─────────────────────────────────────────────
# LLM 모드 (선택)
# 비우거나 auto → Claude로 프로필·기획안을 만든다.
# off         → Claude를 호출하지 않고 규칙 기반으로만 분석한다.
# ANTHROPIC_API_KEY가 비어 있으면 값과 무관하게 규칙 기반으로 동작한다.
# 크레딧이 소진되어 호출이 실패해도 규칙 기반 결과가 나온다.
# ─────────────────────────────────────────────
LLM_MODE=auto
